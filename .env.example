# .env.example - variables used by uber-taxi-agentic-etl
# Copy to .env for local runs, or set them as environment variables / Job parameters
# on Databricks. NEVER put real secret values in this file or in Git.

# --- Azure storage (ADLS Gen2) ---
STORAGE_ACCOUNT=stuberetlabhi01
SECRET_SCOPE=uber-etl-scope

# --- Unity Catalog namespace ---
CATALOG=dbw_uber_etl
SCHEMA=uber_etl

# --- Pipeline ---
LOAD_MODE=full                       # full | incremental
EXPECTED_START_DATE=2024-01-01       # timeliness check range
EXPECTED_END_DATE=2024-12-30
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
JOB_NAME=uber-taxi-etl
ETL_JOB_ID=                          # optional: agents look the Job up by JOB_NAME if empty
CLUSTER_NAME=uber-etl-cluster
ALERT_EMAIL=                         # Job failure alerts (defaults to your Databricks login)
JOB_TIMEOUT_SECONDS=1800
JOB_POLL_SECONDS=20

# --- Microsoft Foundry GPT ---
# Either set these here / as env vars, or store them in Key Vault as
# foundry-endpoint and foundry-deployment (what this project does).
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
FOUNDRY_DEPLOYMENT=<your-gpt-deployment-name>
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_AUTH_MODE=entra              # entra (preferred) | key

# --- Secrets: stored in Azure Key Vault, read through the Databricks secret scope ---
# Listed here by NAME only, for local testing fallbacks. Leave values empty.
SP_CLIENT_ID=
SP_TENANT_ID=
SP_CLIENT_SECRET=
FOUNDRY_API_KEY=
